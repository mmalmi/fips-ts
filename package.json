{
  "name": "fips-ts",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Browser TypeScript FIPS with WebRTC/Nostr transport",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "ws": "^8.21.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@fips/core": "link:packages/core",
      "@fips/transport-webrtc": "link:packages/transport-webrtc",
      "js-yaml": "4.2.0"
    }
  }
}
