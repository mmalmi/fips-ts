{
  "name": "@fips/hashtree-adapter",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fips/core": "workspace:*",
    "@msgpack/msgpack": "^3.0.0",
    "@noble/hashes": "^1.6.1"
  },
  "devDependencies": {
    "@fips/transport-memory": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@hashtree/core": "*",
    "@hashtree/mesh": "*"
  },
  "peerDependenciesMeta": {
    "@hashtree/core": { "optional": true },
    "@hashtree/mesh": { "optional": true }
  }
}
